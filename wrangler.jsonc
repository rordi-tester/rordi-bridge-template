/**
 * RD-14142 — helper Worker template config.
 *
 * The Deploy to Cloudflare button reads this file to decide what to prompt the
 * customer for. Everything under `vars` becomes a text input; everything under
 * `secrets` becomes a masked input whose value Cloudflare stores directly as a
 * Worker Secret. That is the whole custody claim of this mode: the pairing code
 * and installation key are typed into Cloudflare's UI and never transit Rordi
 * on their way in.
 *
 * UNVERIFIED — this file's deploy-button behaviour has NOT been proven against
 * a live Cloudflare account. The `secrets` block shape in particular is taken
 * from documentation, not from an observed deploy. See RD-14142.
 */
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "rordi-bridge",
  "main": "src/worker.js",
  // Pinned, not floating: a template that silently changes runtime semantics
  // between a customer's first deploy and their update PR is a drift source.
  "compatibility_date": "2026-08-01",
  "observability": { "enabled": true },

  // Supplies cf_version_id / cf_version_tag to /_rordi/attest, so Rordi can
  // compare desired vs observed version without a Cloudflare API grant.
  "version_metadata": { "binding": "VERSION" },

  "vars": {
    "RORDI_URL": "https://app.rordi.dev",
    "RORDI_WORKSPACE": ""
  },

  // Prompted and stored by Cloudflare at deploy time.
  "secrets": ["RORDI_PAIRING_CODE", "RORDI_BRIDGE_KEY"]
}
