/**
 * RD-14142 — helper Worker template config.
 *
 * The Deploy to Cloudflare button reads this file to decide what to prompt the
 * customer for. Everything under `vars` becomes a text input; everything under
 * `secrets` becomes a masked input whose value Cloudflare stores directly as a
 * Worker Secret. That is the whole custody claim of this mode: the pairing code
 * and installation key are typed into Cloudflare's UI and never transit Rordi
 * on their way in.
 *
 * UNVERIFIED — this file's deploy-button behaviour has NOT been proven against
 * a live Cloudflare account. The `secrets` block shape in particular is taken
 * from documentation, not from an observed deploy. See RD-14142.
 */
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "rordi-bridge",
  "main": "src/worker.js",
  // Pinned, not floating: a template that silently changes runtime semantics
  // between a customer's first deploy and their update PR is a drift source.
  "compatibility_date": "2026-08-01",
  "observability": { "enabled": true },

  // Supplies cf_version_id / cf_version_tag to /_rordi/attest, so Rordi can
  // compare desired vs observed version without a Cloudflare API grant.
  "version_metadata": { "binding": "VERSION" },

  // ONLY values that are OURS to set live here.
  //
  // Anything the CUSTOMER supplies must NOT be a var. Workers Builds runs
  // `wrangler deploy` on every merge, which re-applies this block verbatim and
  // RESETS whatever the customer entered. Measured: RORDI_WORKSPACE went from
  // `ws_spike_14142` back to `""` on the first automatic build, which would
  // silently unbind the installation from its workspace on every update.
  // Secrets are NOT reset — so customer-supplied config belongs below.
  "vars": {
    "RORDI_URL": "https://app.rordi.dev"
  },

  // Prompted and stored by Cloudflare at deploy time.
  //
  // MUST be an OBJECT keyed by secret name. An array is REJECTED outright:
  // `The field "secrets" should be an object but got [...]` — verified against
  // wrangler 4.81.1, which also warns that `secrets` is EXPERIMENTAL and "may
  // change or break at any time". Re-verify this shape on each wrangler bump;
  // a template that fails config validation never reaches the prompt at all.
  "secrets": {
    "RORDI_WORKSPACE": { "description": "Workspace id this install belongs to" },
    "RORDI_PAIRING_CODE": { "description": "One-time pairing code from Rordi" },
    "RORDI_BRIDGE_KEY": { "description": "Installation key from Rordi" }
  }
}
